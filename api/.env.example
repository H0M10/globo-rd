# Copia este archivo como ".env" (solo para pruebas locales). NUNCA subas .env a GitHub.
# En AWS Lambda estas mismas claves van en Configuración › Variables de entorno.
PGHOST=bd-expo-postgres.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=escuela
PGUSER=globo_app
PGPASSWORD=la-contrasena-de-globo_app
# Clave para reiniciar o configurar el juego desde la página admin (mínimo 8 caracteres)
ADMIN_KEY=cambia-esta-clave-admin
# Quién puede usar la API. Pon tu GitHub Pages, por ejemplo: https://tu-usuario.github.io
ALLOWED_ORIGIN=*
